# Server Configuration
PORT=5000
MONGO_URI=mongodb://localhost:27017/phonebook
JWT_SECRET=your_jwt_secret_key_here
CLIENT_URL=http://localhost:5173,https://your-app.vercel.app

# Cloudinary Credentials (for profile images)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Brevo (formerly Sendinblue) Credentials (for transactional emails)
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=noreply@yourdomain.com
